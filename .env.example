# Copy this file to .env and fill in values. Never commit .env.

# Optional. Leave blank to use only backtesting + manual bet tracking.
# Get a free key at https://the-odds-api.com (500 requests/month).
ODDS_API_KEY=

# INFO in dev, WARNING in prod.
LOG_LEVEL=INFO

# Where the React dev server runs — used by the Vite app to reach the API.
VITE_API_URL=http://localhost:8000
